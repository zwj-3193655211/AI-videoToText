# AI-VedioToText 配置模板
# 复制为 .env 后填实际值（.env 已在 .gitignore 中，不会入库）

# ===== LLM 服务商 =====
# 选择 llm_provider：
#   - ollama   : 本地 Ollama（默认）
#   - deepseek : DeepSeek 云端 API
LLM_PROVIDER=ollama

# ===== Ollama（本地）配置 =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 启动应用时是否自动拉起 ollama serve
OLLAMA_AUTO_START=true

# ===== DeepSeek API 配置 =====
# 从 https://platform.deepseek.com 申请
# 注意：deepseek-chat / deepseek-reasoner 2026-07-24 已下线
# 当前可用：deepseek-v4-flash（免费）/ v4-pro（付费）/ v4-pro-max（最强）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 翻译/总结 行为 =====
# 温度（0-1，越低越确定）
LLM_TEMPERATURE=0.3
# 翻译并发批次数（1-4，建议 2-3）
LLM_CONCURRENCY=2

# ===== ASR 语音识别 =====
# 后端：funasr（基石，默认，含 VAD+标点）/ faster-whisper（可选，需自行下载模型）
ASR_BACKEND=funasr
# 模型：offline（唯一，Paraformer + VAD + 标点，实时/离线通用）
ASR_MODEL=offline
# 模型根目录（download.py 下载到的位置，默认项目根 ./model）
# ASR_MODEL_DIR=
# 计算设备：auto / cuda / cpu
ASR_DEVICE=auto
# 是否启用 CT-PUNC 标点模型
ASR_USE_PUNC=true
