# AI-VedioToText 配置模板
# 复制为 .env 后填实际值（.env 已在 .gitignore 中，不会入库）

# ===== LLM 服务商 =====
# 选择 llm_provider：
#   - ollama   : 本地 Ollama（默认）
#   - deepseek : DeepSeek 云端 API
LLM_PROVIDER=ollama

# ===== Ollama（本地）配置 =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 启动应用时是否自动拉起 ollama serve
OLLAMA_AUTO_START=true

# ===== DeepSeek API 配置 =====
# 从 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：deepseek-chat（V3，便宜快）/ deepseek-reasoner（R1，推理强）
DEEPSEEK_MODEL=deepseek-chat

# ===== 翻译/总结 行为 =====
# 温度（0-1，越低越确定）
LLM_TEMPERATURE=0.3
# 翻译并发批次数（1-4，建议 2-3）
LLM_CONCURRENCY=2

# ===== ASR 语音识别 =====
# 可用模型（多语种支持）：
#   - Systran/faster-whisper-large-v3      (1.5GB, 准确度最高, 推荐)
#   - Systran/faster-whisper-medium        (1.5GB, 折中)
#   - Systran/faster-whisper-small         (460MB, 速度快)
# 注意：distil-whisper 是英文专用蒸馏版，不支持中文/多语种，不要选
# 模型会自动下载到 ASR_MODEL_DIR
ASR_MODEL=Systran/faster-whisper-large-v3
# ASR_MODEL_DIR=
# 计算设备：cuda / cpu
ASR_DEVICE=auto
# 计算精度：float16 / int8 / float32
ASR_COMPUTE_TYPE=float16
